# gateway-nginx — API gateway that routes to the other services, port 80
#
# Build from the project root, so configs/ and data/ are both in reach:
#   docker build -f dockerfiles/Dockerfile.gateway-nginx -t gateway-nginx .
# Run with the datacenter name:
#   docker run -d -e DC=DC1 gateway-nginx
FROM nginx:alpine

# Remove nginx's own welcome site, so only our files are served.
RUN rm -f /etc/nginx/conf.d/default.conf && rm -rf /usr/share/nginx/html/*

COPY configs/nginx/gateway-nginx.conf /etc/nginx/conf.d/gateway-nginx.conf
COPY data/service-responses/gateway-nginx/ /usr/share/nginx/html/

# Fills in the datacenter name when the container starts.
COPY configs/nginx/40-set-dc.sh /docker-entrypoint.d/40-set-dc.sh
RUN chmod +x /docker-entrypoint.d/40-set-dc.sh

EXPOSE 80

# Docker calls /health every 10s. Three misses in a row = unhealthy.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:80/health || exit 1
